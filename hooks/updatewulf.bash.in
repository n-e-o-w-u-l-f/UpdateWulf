# Cached status for interactive Bash, drawn before readline displays PS1.
[[ $- == *i* && ${TERM-} != dumb && ${_updatewulf_prompt_registered-} != 1 ]] || return 0

if [[ -z ${UPDATEWULF_PROMPT_CACHE_DIR-} ]]; then
    UPDATEWULF_PROMPT_CACHE_DIR=__STATE_QUOTED__
fi

_updatewulf_prompt_attach() {
    local exit_status=$? LC_ALL=C
    local columns=${COLUMNS:-80} rows=${LINES:-24} target=22 available
    local cache=$UPDATEWULF_PROMPT_CACHE_DIR timestamp= now= line= path=
    local sgr=$'\e''\[[0-9;]*m' color= first=1
    [[ -t 1 ]] || return "$exit_status"
    [[ $columns =~ ^[1-9][0-9]{0,4}$ && $rows =~ ^[1-9][0-9]{0,4}$ ]] || return "$exit_status"
    (( columns >= 12 && rows >= 2 )) || return "$exit_status"
    available=$((rows - 1))
    if [[ ${_shellrpg_prompt_registered-} == 1 ]] && (( available > 1 )); then
        available=$((available - 1))
    fi
    [[ -z ${NO_COLOR+x} && -n ${TERM-} ]] && color=1
    for target in 240 160 120 80 40 22; do
        (( columns >= target )) && break
    done

    if [[ -f $cache/heartbeat.txt ]] && IFS= read -r -n 20 timestamp < "$cache/heartbeat.txt"; then
        printf -v now '%(%s)T' -1
        if [[ $timestamp =~ ^[1-9][0-9]{0,11}$ ]] && (( now >= timestamp && now - timestamp <= 180 )); then
            path=$cache/fleet-prompt.bash.$target
            [[ -r $path && -f $path ]] || path=$cache/fleet-prompt.txt
        fi
    fi

    if [[ -n $path && -r $path && -f $path ]]; then
        while IFS= read -r -n 4096 line || [[ -n $line ]]; do
            while [[ $line =~ $sgr ]]; do
                line=${line//"${BASH_REMATCH[0]}"/}
            done
            line=${line//\\[/}
            line=${line//\\]/}
            line=${line//[! -~]/}
            [[ -n $line ]] || continue
            if (( ${#line} >= columns )); then
                line=${line:0:columns-4}...
            fi
            if [[ $color ]]; then
                if (( first )); then printf '\e[1;92m%s\e[0m\n' "$line"
                else printf '\e[33m%s\e[0m\n' "$line"; fi
            else
                printf '%s\n' "$line"
            fi
            first=0
            available=$((available - 1))
            (( available > 0 )) || break
        done < "$path"
    fi
    if (( first )); then
        line='UpdateWulf [Status veraltet]'
        if (( ${#line} >= columns )); then line=UpdateWulf; fi
        if [[ $color ]]; then printf '\e[33m%s\e[0m\n' "$line"
        else printf '%s\n' "$line"; fi
    fi
    return "$exit_status"
}

# Upgrade a sourced legacy hook in place and preserve other prompt owners.
if [[ ${SHELL_COLOR_PS1_DECORATOR-} == _updatewulf_prompt_decorate ]]; then
    if [[ -n ${UPDATEWULF_PREVIOUS_DECORATOR-} ]]; then
        SHELL_COLOR_PS1_DECORATOR=$UPDATEWULF_PREVIOUS_DECORATOR
    else
        unset SHELL_COLOR_PS1_DECORATOR
    fi
fi
if [[ -n ${UPDATEWULF_LAST_HEADER-} && ${PS1-} == "$UPDATEWULF_LAST_HEADER"$'\n'* ]]; then
    PS1=${PS1#"$UPDATEWULF_LAST_HEADER"$'\n'}
fi
unset UPDATEWULF_LAST_HEADER

_updatewulf_pc=$(declare -p PROMPT_COMMAND 2>/dev/null) || _updatewulf_pc=
if [[ $_updatewulf_pc =~ ^declare\ -[^[:space:]]*r ]]; then
    unset _updatewulf_pc
    return 0
fi
if [[ $_updatewulf_pc != *'_updatewulf_prompt_attach'* ]]; then
    if [[ $_updatewulf_pc =~ ^declare\ -[^[:space:]]*a ]]; then
        PROMPT_COMMAND+=(_updatewulf_prompt_attach)
    else
        PROMPT_COMMAND+=${PROMPT_COMMAND:+$'\n'}_updatewulf_prompt_attach
    fi
fi
unset _updatewulf_pc
_updatewulf_prompt_registered=1
